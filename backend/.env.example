# ==============================================================================
# Sentinel Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env in backend/ or root for local environment overrides.
# NEVER commit production credentials or actual API keys to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_32_byte_hex_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinel_soc

# Optional SQLite fallback for lightweight local unit tests without Docker:
# TEST_DATABASE_URL=sqlite:///./test_sentinel.db
