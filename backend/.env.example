# ==============================================================================
# Sentinel Platform - Environment Variables Template
# ==============================================================================
# Copy this file to .env in backend/ for local development overrides.
# NEVER commit production credentials, actual passwords, or secret keys.

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Whitelist (JSON array or comma-separated URLs; DO NOT use '*' in production with credentials)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & JWT Authentication (Generate in terminal: openssl rand -hex 32)
SECRET_KEY=sentinel_insecure_development_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Request & Upload Limits
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_RECORDS_PER_IMPORT=10000

# Database Configuration (PostgreSQL; SQLite supported for local testing)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinel_soc

# Optional Initial Demo Account Passwords (for backend/scripts/seed_users.py)
# If omitted, cryptographically random passwords will be generated and printed once.
INITIAL_ADMIN_PASSWORD=
INITIAL_RESPONDER_PASSWORD=
INITIAL_ENGINEER_PASSWORD=
INITIAL_ANALYST_PASSWORD=
INITIAL_MANAGER_PASSWORD=
