# ==============================================================================
# Sentinel Platform — Unified Root Environment Configuration Template
# ==============================================================================
# For local development:
# 1. Copy variables under BACKEND to backend/.env
# 2. Copy variables under FRONTEND to frontend/.env
# NEVER commit production secrets or real API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Whitelist (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# JWT Session Authentication (Generate in terminal: openssl rand -hex 32)
SECRET_KEY=sentinel_insecure_development_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Request & Upload Limits (10MB upload ceiling)
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_RECORDS_PER_IMPORT=10000

# Database Connection (PostgreSQL for production/staging, SQLite for local testing)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinel_soc
# Fallback SQLite for quick development:
# DATABASE_URL=sqlite:///./sentinel_dev.db

# Optional Initial Demo Account Passwords (for backend/scripts/seed_demo_data.py)
# If left blank, defaults to 'Sentinel@Demo2026!'
SENTINEL_DEMO_PASSWORD=Sentinel@Demo2026!
INITIAL_ADMIN_PASSWORD=
INITIAL_RESPONDER_PASSWORD=
INITIAL_ENGINEER_PASSWORD=
INITIAL_ANALYST_PASSWORD=
INITIAL_MANAGER_PASSWORD=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# ------------------------------------------------------------------------------
# Base URL pointing to the FastAPI backend API
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=Sentinel SOC
VITE_APP_VERSION=0.1.0
